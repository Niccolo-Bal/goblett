# Copy to .env (gitignored) for local dev, and set the same variables in
# Cloudflare Pages -> Settings -> Variables and Secrets (add the key as a Secret).
# Only the server functions (functions/api/*.js) read them, never the browser.
# The tables are created by running supabase/accounts.sql and supabase/elections.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Sign-in by email or Google (functions/api/circle.js), through Circle user-controlled
# wallets. Leave CIRCLE_API_KEY out and the site offers MetaMask only.
# A TEST_API_KEY works on testnets only, a LIVE_API_KEY on mainnet only.
# In the Circle console (Wallets -> User Controlled -> Configurator -> Authentication
# Methods), set up Email (the address and SMTP server the codes are sent from) and, for
# Google, paste the same client ID as below.
CIRCLE_API_KEY=TEST_API_KEY:...
# Optional. The app id is public and is looked up with the key if this is missing.
# CIRCLE_APP_ID=
# Optional: shows "Continue with Google". A Google Cloud OAuth client ID (type "Web
# application") whose authorized redirect URIs include <site origin>/app.html.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
