# Copy to .env (gitignored) for local dev, and set the same two variables in
# Cloudflare Pages -> Settings -> Variables and Secrets (add the key as a Secret).
# Only the server function (functions/api/account.js) reads them, never the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
