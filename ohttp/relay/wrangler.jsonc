// OHTTP relay Worker. Deploy from this folder: `npx wrangler deploy`.
{
  "name": "goblett-ohttp-relay",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "routes": [{ "pattern": "relay.goblett.xyz", "custom_domain": true }],
  // No logs: the relay must not keep a record of which address sent something when.
  "observability": { "enabled": false },
  // Per-address limit (R4-5). Also set the shared secret: `npx wrangler secret put RELAY_TOKEN`.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    "GATEWAY_URL": "https://gateway.goblett.xyz/",
    "ALLOWED_ORIGINS": "https://goblett.xyz,https://ux.goblett.xyz,https://ember.goblett.xyz,http://localhost:5173"
  }
}
