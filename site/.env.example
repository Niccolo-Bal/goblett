# Copy to .env (gitignored) for local dev, and set the same variables in
# Cloudflare Pages -> Settings -> Variables and Secrets (add the key as a Secret).
# Only the server functions (functions/api/*.js) read them, never the browser.
# The tables are created by running supabase/accounts.sql and supabase/elections.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Sign-in by email or Google (functions/api/circle.js), through Circle user-controlled
# wallets. Circle keeps testnets and mainnet apart: a TEST_API_KEY works on testnets only
# and a LIVE_API_KEY on mainnet only, each with its own users, wallets and console
# settings (so set up Email under both environments). Give one key for each network the
# site should offer email sign-in on; without a network's key it offers MetaMask only
# there. A key in the wrong variable is ignored.
# In the Circle console (Wallets -> User Controlled -> Configurator -> Authentication
# Methods), set up Email (the address and SMTP server the codes are sent from) and, for
# Google, paste the same client ID as below.
CIRCLE_API_KEY_TEST=TEST_API_KEY:...
CIRCLE_API_KEY_MAIN=LIVE_API_KEY:...
# Optional. Each key's app id is public and is looked up with the key if this is missing.
# CIRCLE_APP_ID_TEST=
# CIRCLE_APP_ID_MAIN=
# Optional: shows "Continue with Google". A Google Cloud OAuth client ID (type "Web
# application") whose authorized redirect URIs include <site origin>/app.html.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Paying for an election (the funding step of "Start an election").
# Testnet: a faucet (functions/api/faucet.js) that sends 2 test USDC from this wallet to
# accounts that are short. Leave it out and the button is not shown. Testnet funds only.
FAUCET_PRIVATE_KEY=0x...
# Mainnet: buying USDC through Circle's on-ramp widget (functions/api/onramp.js). It uses
# CIRCLE_API_KEY_MAIN above; card payments also need the business verified in the Circle
# console (App Kits), and the site's domain given here as registered there.
# ONRAMP_REFERRER_DOMAIN=goblett.xyz
