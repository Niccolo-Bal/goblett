// How Cloudflare deploys the site: `npm run build`, then `npx wrangler deploy`.
// Secrets are not here. Set them once on the Worker (dashboard -> goblett -> Settings ->
// Variables and Secrets, or `npx wrangler secret put NAME`):
//   SUPABASE_URL, SUPABASE_SECRET_KEY   (accounts and the election list; see .env.example)
//   CIRCLE_API_KEY, CIRCLE_LIVE_API_KEY, GOOGLE_CLIENT_ID   (sign-in by email or Google, and buying funds; optional)
//   FAUCET_PRIVATE_KEY                  (testnet faucet; optional)
{
  "name": "goblett",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (/testnet, ?election=...) get index.html, as before.
    "not_found_handling": "single-page-application",
    // Only /api/* runs worker.js; everything else is served straight from dist/.
    "run_worker_first": ["/api/*"]
  }
}
