# For running the gateway under Node (gateway/server.mjs). Copy to .env (gitignored).
# OHTTP_SEED is SECRET: whoever has it can decrypt what voters send. Make one with keygen.mjs.
OHTTP_SEED=
NOSTR_RELAYS=wss://nos.lol,wss://relay.primal.net
RPC_URLS={"5042":"https://rpc.mainnet.arc.io","5042002":"https://rpc.testnet.arc.io"}
PORT=8788
